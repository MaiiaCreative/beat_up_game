func _ready():
	$MusicPlayer.stream = level_info.get(current_level_name).get("music")
	$MusicPlayer.play()

	if in_edit_mode:
		SignalIs.KeyListenerPress.connect(KeyListenerPress)
	else:
		var fk_times = level_info.get(current_level_name).get("fk_times")
		var fk_times_arr = str_to_var(fk_times)

		var counter := 0
		for key in fk_times_arr:
			var button_name := ""
			match counter:
				0: button_name = "Left"
				1: button_name = "Down"
				2: button_name = "Up"
				3: button_name = "Right"

			for delay in key:
				SpawnFallinKey(button_name, delay)

			counter += 1

func KeyListenerPress(button_name: String, array_num: int):
	var time_to_spawn = $MusicPlayer.get_playback_position() - fk_fall_time
	fk_output_arr[array_num].append(time_to_spawn)
	print("SPAWN LOG: ", button_name, " at ", time_to_spawn)

func SpawnFallinKey(button_name: String, delay: float):
	await get_tree().create_timer(delay).timeout
	SignalIs.CreateFallingKey.emit(button_name)

func _on_music_player_finished():
	if in_edit_mode:
		print(fk_output_arr)
	else:
		get_tree().change_scene_to_file("res://Scenes/Score_Screen.tscn")
